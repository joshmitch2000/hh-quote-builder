<mjml>
  <mj-head>
    <mj-title>New Quote Request - Him &amp; Her Music</mj-title>
    <mj-preview>New quote request submission details</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
      />
      <mj-text font-size="14px" line-height="22px" color="#262626" />
      <mj-table font-size="14px" line-height="22px" color="#262626" />
    </mj-attributes>
    <mj-style inline="inline">
      .table-label {
        font-weight: 500;
        color: #595959;
        width: 38%;
        padding: 10px 12px;
        border-bottom: 1px solid #ebebeb;
        vertical-align: top;
      }
      .table-value {
        color: #1a1a1a;
        padding: 10px 12px;
        border-bottom: 1px solid #ebebeb;
        vertical-align: top;
        white-space: pre-line;
      }
      .table-total-label {
        font-weight: 600;
        font-size: 15px;
        color: #1a1a1a;
        padding: 12px;
        border-top: 1px solid #1a1a1a;
        border-bottom: 1px solid #1a1a1a;
        background-color: #f7f7f7;
      }
      .table-total-value {
        font-weight: 600;
        font-size: 15px;
        color: #1a1a1a;
        padding: 12px;
        border-top: 1px solid #1a1a1a;
        border-bottom: 1px solid #1a1a1a;
        background-color: #f7f7f7;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f5f5f5">
    <!-- Header with Logo -->
    <mj-section background-color="#313A33" padding="36px 20px">
      <mj-column>
        <mj-image
          src="https://himandhermusic.com/wp-content/uploads/2021/11/splash-logo.png"
          alt="Him &amp; Her Music"
          width="160px"
          padding="0"
          align="center"
        />
      </mj-column>
    </mj-section>

    <!-- Intro Card -->
    <mj-section background-color="#ffffff" padding="32px 32px 16px 32px">
      <mj-column>
        <mj-text
          font-size="18px"
          font-weight="600"
          color="#1a1a1a"
          padding="0 0 10px 0"
        >
          New quote request received
        </mj-text>
        <mj-text color="#595959" padding="0">
          A new quote request has been submitted through the wedding music
          package builder. Details and selections are outlined below.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Quote Summary Section -->
    <mj-section background-color="#ffffff" padding="12px 32px 16px 32px">
      <mj-column>
        <mj-text
          font-size="15px"
          font-weight="600"
          color="#1a1a1a"
          padding="0 0 10px 0"
        >
          Quote details
        </mj-text>
        <mj-table padding="0">
          <tr>
            <td class="table-label">Selected coverage</td>
            <td class="table-value">[field id="selected_coverage"]</td>
          </tr>
          <tr>
            <td class="table-label">Selected style</td>
            <td class="table-value">[field id="selected_style"]</td>
          </tr>
          <tr>
            <td class="table-label">Package name</td>
            <td class="table-value">
              <strong>[field id="package_name"]</strong>
            </td>
          </tr>
          <tr>
            <td class="table-label">Base price</td>
            <td class="table-value">$[field id="base_price"] + GST</td>
          </tr>
          <tr>
            <td class="table-label">Selected add-ons</td>
            <td class="table-value">[field id="selected_addons_summary"]</td>
          </tr>
          <tr>
            <td class="table-total-label">Estimated total</td>
            <td class="table-total-value">
              $[field id="estimated_total"] + GST
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Customer & Additional Details Section -->
    <mj-section background-color="#ffffff" padding="16px 32px 32px 32px">
      <mj-column>
        <mj-text
          font-size="15px"
          font-weight="600"
          color="#1a1a1a"
          padding="0 0 10px 0"
        >
          Customer information
        </mj-text>
        <mj-table padding="0">
          <tr>
            <td class="table-label">Email</td>
            <td class="table-value">
              <a
                href='mailto:[field id="email"]'
                style="color: #1a1a1a; text-decoration: underline"
                >[field id="email"]</a
              >
            </td>
          </tr>
          <tr>
            <td class="table-label">Preferred musicians</td>
            <td class="table-value">[field id="preferred_musicians"]</td>
          </tr>
          <tr>
            <td class="table-label">Wedding planning info</td>
            <td class="table-value">[field id="wedding_planning"]</td>
          </tr>
          <tr>
            <td class="table-label">Message</td>
            <td class="table-value">[field id="message"]</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f5f5f5" padding="24px 32px 32px 32px">
      <mj-column>
        <mj-divider
          border-width="1px"
          border-style="solid"
          border-color="#e0e0e0"
          padding="0 0 16px 0"
        />
        <mj-text
          align="center"
          font-size="12px"
          line-height="18px"
          color="#737373"
          padding="0"
        >
          Sent via Him &amp; Her Music package quote builder.<br />
          <a
            href="https://himandhermusic.com"
            style="color: #595959; text-decoration: underline"
            >himandhermusic.com</a
          >
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
