<mjml>
  <mj-head>
    <mj-title>Your Quote Estimate - Him &amp; Her Music</mj-title>
    <mj-preview>Thank you for your wedding music quote request</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
      />
      <mj-text font-size="14px" line-height="22px" color="#262626" />
      <mj-table font-size="14px" line-height="22px" color="#262626" />
    </mj-attributes>
    <mj-style inline="inline">
      .table-label {
        font-weight: 500;
        color: #595959;
        width: 40%;
        padding: 10px 12px;
        border-bottom: 1px solid #ebebeb;
        vertical-align: top;
      }
      .table-value {
        color: #1a1a1a;
        padding: 10px 12px;
        border-bottom: 1px solid #ebebeb;
        vertical-align: top;
        white-space: pre-line;
      }
      .table-total-label {
        font-weight: 600;
        font-size: 15px;
        color: #1a1a1a;
        padding: 12px;
        border-top: 1px solid #1a1a1a;
        border-bottom: 1px solid #1a1a1a;
        background-color: #f7f7f7;
      }
      .table-total-value {
        font-weight: 600;
        font-size: 15px;
        color: #1a1a1a;
        padding: 12px;
        border-top: 1px solid #1a1a1a;
        border-bottom: 1px solid #1a1a1a;
        background-color: #f7f7f7;
      }
      .disclaimer-box {
        background-color: #f7f7f7;
        border-left: 3px solid #737373;
        padding: 14px 16px;
        font-size: 13px;
        line-height: 20px;
        color: #404040;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f5f5f5">
    <!-- Header with Logo -->
    <mj-section background-color="#313A33" padding="36px 20px">
      <mj-column>
        <mj-image
          src="https://himandhermusic.com/wp-content/uploads/2021/11/splash-logo.png"
          alt="Him &amp; Her Music"
          width="160px"
          padding="0"
          align="center"
        />
      </mj-column>
    </mj-section>

    <!-- Warm Introduction -->
    <mj-section background-color="#ffffff" padding="32px 32px 16px 32px">
      <mj-column>
        <mj-text
          font-size="18px"
          font-weight="600"
          color="#1a1a1a"
          padding="0 0 10px 0"
        >
          Thank you for your enquiry
        </mj-text>
        <mj-text color="#595959" padding="0">
          We have received your wedding music quote request. Here is a summary
          of the package and add-ons you selected:
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Quote Summary Table -->
    <mj-section background-color="#ffffff" padding="12px 32px 20px 32px">
      <mj-column>
        <mj-text
          font-size="15px"
          font-weight="600"
          color="#1a1a1a"
          padding="0 0 10px 0"
        >
          Quote summary
        </mj-text>
        <mj-table padding="0">
          <tr>
            <td class="table-label">Selected coverage</td>
            <td class="table-value">[field id="selected_coverage"]</td>
          </tr>
          <tr>
            <td class="table-label">Selected style</td>
            <td class="table-value">[field id="selected_style"]</td>
          </tr>
          <tr>
            <td class="table-label">Package name</td>
            <td class="table-value">
              <strong>[field id="package_name"]</strong>
            </td>
          </tr>
          <tr>
            <td class="table-label">Base price</td>
            <td class="table-value">$[field id="base_price"] + GST</td>
          </tr>
          <tr>
            <td class="table-label">Selected add-ons</td>
            <td class="table-value">[field id="selected_addons_summary"]</td>
          </tr>
          <tr>
            <td class="table-total-label">Estimated total</td>
            <td class="table-total-value">
              $[field id="estimated_total"] + GST
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Disclaimer & Next Steps -->
    <mj-section background-color="#ffffff" padding="8px 32px 32px 32px">
      <mj-column>
        <mj-text
          font-size="15px"
          font-weight="600"
          color="#1a1a1a"
          padding="0 0 10px 0"
        >
          What happens next?
        </mj-text>
        <mj-text padding="0 0 16px 0" line-height="22px" color="#595959">
          Our team will review your selections, check artist availability for
          your date, and follow up shortly with a confirmed quote and next
          steps.
        </mj-text>
        <mj-text padding="0">
          <div class="disclaimer-box">
            <strong>Please note:</strong> This is only an indicative estimate
            and not a final quote. Artist quotes may vary, travel fees may apply
            depending on venue location, and all dates are subject to artist
            availability.
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f5f5f5" padding="24px 32px 32px 32px">
      <mj-column>
        <mj-divider
          border-width="1px"
          border-style="solid"
          border-color="#e0e0e0"
          padding="0 0 16px 0"
        />
        <mj-text
          align="center"
          font-size="13px"
          line-height="20px"
          color="#595959"
          padding="0 0 6px 0"
        >
          Have questions in the meantime? You can reply directly to this email.
        </mj-text>
        <mj-text
          align="center"
          font-size="12px"
          line-height="18px"
          color="#737373"
          padding="0"
        >
          Him &amp; Her Music &bull;
          <a
            href="https://himandhermusic.com"
            style="color: #595959; text-decoration: underline"
            >himandhermusic.com</a
          >
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
